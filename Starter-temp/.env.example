# Database Connection
# Replace with your local PostgreSQL credentials
DATABASE_URL="postgresql://username:password@localhost:5432/stockmaster?schema=public"
DB_TYPE="postgres"

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Optional for local dev if not using Google Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
